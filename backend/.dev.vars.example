# Copy this file to `.dev.vars` for local development.
# `.dev.vars` is git-ignored and must never be committed.

DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_ACCELERATE_API_KEY"

# Use a long, random value (for example: `openssl rand -base64 48`).
JWT_SECRET="replace-with-a-long-random-secret"

# Optional: comma-separated list of frontend origins allowed by CORS.
# Leave unset for local development (defaults to allowing all origins).
# CORS_ORIGINS="http://localhost:5173"
